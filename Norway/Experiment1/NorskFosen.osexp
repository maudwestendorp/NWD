	set break_if never
	setcycle 0 read1 "Døra til klasserommet vart låst av vaktmesteren."
	setcycle 0 invert1 "Vaktmesteren låste …"
	setcycle 0 cond1 test
	setcycle 0 nr1 test
	setcycle 0 arg1 NP
	setcycle 0 read2 "Kalle vart låst inn i klasserommet av læreren."
	setcycle 0 invert2 "Læreren låste …"
	setcycle 0 cond2 test
	setcycle 0 nr2 test
	setcycle 0 arg2 NP
	run trial

define sequence trial
	set flush_keyboard yes
	set description "Runs a number of items in sequence"
	run stimuli_read always
	run sound_read always
	run read always
	run stimuli_produce always
	run sound_produce always
	run produce always
	run response1 always
	run stimuli_read2 always
	run sound_read2 always
	run read2 always
	run stimuli_produce2 always
	run sound_produce2 always
	run produce2 always
	run response2 always
	run empty always
	run logger always

define sequence trial_testrunde
	set flush_keyboard yes
	set description "Runs a number of items in sequence"
	run stimuli_read_prac always
	run sound_read always
	run read always
	run stimuli_produce_prac always
	run sound_produce always
	run produce always
	run response1 always
	run stimuli_read2_prac always
	run sound_read2 always
	run read2 always
	run stimuli_produce2_prac always
	run sound_produce2 always
	run produce2 always
	run response2 always

define sketchpad velkommmen
	set duration keypress
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=sans font_italic=no font_size=40 html=yes show_if=always text="Velkommen!" x=0 y=0 z_index=0

