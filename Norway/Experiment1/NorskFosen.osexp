	setcycle 12 arg2 PRO
	setcycle 13 read1 "Den vart hengt opp på veggen av læreren."
	setcycle 13 invert1 "Læreren hengte ..."
	setcycle 13 cond1 PartPP
	setcycle 13 nr1 4
	setcycle 13 arg1 PRO
	setcycle 13 read2 "Han vart ikke forsvart av kollegene under møtet."
	setcycle 13 invert2 "Kollegene forsvarte ..."
	setcycle 13 cond2 Neg
	setcycle 13 nr2 13
	setcycle 13 arg2 PRO
	setcycle 14 read1 "Plakaten vart hengt opp av læreren i går."
	setcycle 14 invert1 "Læreren hengte ..."
	setcycle 14 cond1 Part
	setcycle 14 nr1 4
	setcycle 14 arg1 NP
	setcycle 14 read2 "Han vart ikke truffet av kula."
	setcycle 14 invert2 "Kula traff ..."
	setcycle 14 cond2 Neg
	setcycle 14 nr2 14
	setcycle 14 arg2 PRO
	setcycle 15 read1 "Den vart hengt opp av læreren i går."
	setcycle 15 invert1 "Læreren hengte ..."
	setcycle 15 cond1 Part
	setcycle 15 nr1 4
	setcycle 15 arg1 PRO
	setcycle 15 read2 "Kritikeren vart ikke imponert av den nye forestillinga."
	setcycle 15 invert2 "Den nye forestillinga imponerte ..."
	setcycle 15 cond2 Neg
	setcycle 15 nr2 15
	setcycle 15 arg2 NP
	setcycle 16 read1 "Eleven vart skjelt ut av rektoren i går."
	setcycle 16 invert1 "Rektoren skjelte ..."
	setcycle 16 cond1 Met
	setcycle 16 nr1 5
	setcycle 16 arg1 NP
	setcycle 16 read2 "Han vart ikke imponert av den nye forestillinga."
	setcycle 16 invert2 "Den nye forestillinga imponerte ..."
	setcycle 16 cond2 Neg
	setcycle 16 nr2 15
	setcycle 16 arg2 PRO
	setcycle 17 read1 "Ho vart skjelt ut av rektoren i går."
	setcycle 17 invert1 "Rektoren skjelte ..."
	setcycle 17 cond1 Met
	setcycle 17 nr1 5
	setcycle 17 arg1 PRO
	setcycle 17 read2 "Han vart ikke kritisert av journalisten for uttalelsen."
	setcycle 17 invert2 "Journalisten kritiserte ..."
	setcycle 17 cond2 Neg
	setcycle 17 nr2 16
	setcycle 17 arg2 PRO
	run trial

define sketchpad stimuli_produce
	set duration 300
	set description "Displays stimuli"
	draw textline center=0 color=white font_bold=no font_family=sans font_italic=no font_size=28 html=yes show_if=always text="[read1]" x=-400 y=-80 z_index=0
	draw textline center=0 color=white font_bold=no font_family=sans font_italic=no font_size=28 html=yes show_if=always text="[invert1]" x=-400 y=0 z_index=0

