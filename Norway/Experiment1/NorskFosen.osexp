define sketchpad start_del1
	set duration keypress
	set description "Displays stimuli"
	draw textline center=1 color=white font_bold=no font_family=sans font_italic=no font_size=40 html=yes show_if=always text="Første del" x=0 y=-100 z_index=0
	draw textline center=1 color=white font_bold=no font_family=sans font_italic=no font_size=28 html=yes show_if=always text="Øvelsesrunde" x=0 y=0 z_index=0

define sketchpad start_del2
